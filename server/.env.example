PORT=8082
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_VERSION=2022-06-28
NOTION_NAME_PROPERTY=Name
NOTION_STATUS_PROPERTY=Status
NOTION_PRIORITY_PROPERTY=Priority
NOTION_DUE_PROPERTY=Due

# Wrist menu browser connections. Register each exact callback URI with its provider.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REDIRECT_URI=
# New tasks go to Notion when it is configured; set local to keep them only on this server.
TASKS_SEND_TO=notion
# Optional server default weather location (otherwise connect from /api/plugins/manage).
WEATHER_LOCATION=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# Hackathon/demo hosting: share one encrypted plugin connection with every visitor.
# Use 20-80 letters/numbers/underscores. Connect providers once, then set the lock to 1.
PLUGIN_SHARED_PROFILE=
PLUGIN_DEMO_LOCK=0
# Extra browser origins allowed to POST plugin pairing/control requests. The
# backend origin and localhost:8091 are always allowed; add the Vercel origin
# when the client is hosted separately.
PLUGIN_CLIENT_ORIGINS=
