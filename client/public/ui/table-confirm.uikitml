<style>
  @font-face { font-family: "Setup Comic"; src: url("/assets/fonts/Bangers-Regular.ttf"); font-weight: 400; }
  .table-shell { width: 535px; flex-direction: column; gap: 10px; padding: 22px; background-color: #25222d; border-width: 1px; border-color: #695465; border-radius: 18px; font-family: inter; }
  .table-phase { color: #f0b793; font-size: 15px; font-weight: 800; }
  .table-title { color: #fff0e2; font-family: "Setup Comic"; font-size: 46px; line-height: 1.04; font-weight: 400; letter-spacing: 0.6px; }
  .table-body { color: #e0d4df; font-size: 18px; line-height: 1.32; }
  .table-caption { color: #cabbc9; font-size: 15px; }
  .table-label { color: #eadddf; font-size: 16px; font-weight: 800; }
  .table-value { color: #fff0e2; font-size: 28px; font-weight: 800; }
  .table-row { flex-direction: row; align-items: center; gap: 8px; }
  .table-metric { flex-grow: 1; flex-direction: column; gap: 3px; }
  .table-measure { flex-direction: row; align-items: center; gap: 8px; padding: 10px; border-radius: 9px; background-color: #37313e; }
  .table-secondary { flex-grow: 1; height: 42px; padding: 8px; border-radius: 9px; background-color: #403644; color: #f9e9e3; font-size: 16px; font-weight: 700; }
  .table-step { width: 76px; height: 42px; padding: 5px; border-radius: 9px; background-color: #4a3c4c; color: #fff0e2; font-size: 15px; font-weight: 800; }
  .table-primary { height: 47px; border-radius: 9px; background-color: #efbb96; color: #2c212d; font-size: 18px; font-weight: 800; }
  .table-notice { color: #ffd0b3; font-size: 16px; line-height: 1.3; }
</style>
<Panel class="table-shell">
  <div class="table-phase">Table setup</div>
  <div class="table-title">Check your table</div>
  <div class="table-body">Check that the surface lines up with your tabletop.</div>
  <div class="table-measure">
    <div class="table-metric">
      <div class="table-caption">Table height</div>
      <div id="table-height" class="table-value">74.0 cm</div>
    </div>
    <button id="height-minus" class="table-step">-0.5 cm</button>
    <button id="height-plus" class="table-step">+0.5 cm</button>
  </div>
  <div class="table-row">
    <div id="table-size" class="table-caption">Surface</div>
    <div id="table-room" class="table-caption">Room</div>
  </div>
  <div id="table-warning" class="table-notice" style="display: none"></div>
  <div class="table-row">
    <button id="touch-table" class="table-secondary">Touch tabletop</button>
    <button id="shape-check" class="table-secondary">Mark table corners</button>
  </div>
  <div id="table-touch-guide" class="table-notice" style="display: none">Touch the tabletop with the controller tip and pull the trigger.</div>
  <div class="table-label">Table appearance</div>
  <div class="table-row">
    <button id="view-workbench" class="table-secondary">Virtual workbench</button>
    <button id="view-real" class="table-secondary">Real table</button>
  </div>
  <div id="table-tip" class="table-caption">Clear loose items if you use the virtual workbench.</div>
  <button id="yep-button" class="table-primary">Confirm table</button>
</Panel>
