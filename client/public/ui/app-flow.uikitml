<style>
  .root { width: 620px; flex-direction: column; padding: 20px; gap: 12px; background-color: #15171d; border-radius: 20px; }
  .top { flex-direction: row; align-items: center; justify-content: space-between; }
  .kicker { color: #ff3d9f; font-size: 12px; font-weight: 800; letter-spacing: 2px; }
  .stage { color: #677083; font-size: 12px; font-weight: 800; letter-spacing: 1px; }
  .title { color: #f1eadc; font-size: 36px; font-weight: 800; }
  .title-accent { color: #e8ff2a; }
  .body { color: #b9b3a7; font-size: 18px; line-height: 1.45; }
  .muted { color: #7d879a; font-size: 14px; line-height: 1.4; }
  .progress { color: #19e3ff; font-size: 30px; font-weight: 800; }
  .detail { color: #7d879a; font-size: 14px; }
  .row { flex-direction: row; gap: 10px; }
  .page { flex-direction: column; gap: 10px; }
  .button { background-color: #e8ff2a; color: #11131a; padding: 15px; border-radius: 10px; font-size: 19px; font-weight: 800; }
  .button-pink { background-color: #ff3d9f; color: #11131a; padding: 15px; border-radius: 10px; font-size: 19px; font-weight: 800; }
  .button-cyan { background-color: #19e3ff; color: #11131a; padding: 15px; border-radius: 10px; font-size: 19px; font-weight: 800; }
  .button-ghost { background-color: #272b35; color: #f1eadc; padding: 12px; border-radius: 9px; font-size: 15px; font-weight: 700; }
  .big { width: 270px; height: 142px; flex-direction: column; justify-content: center; align-items: center; border-radius: 12px; padding: 16px; font-size: 20px; font-weight: 800; color: #11131a; background-color: #e8ff2a; }
  .big-alt { background-color: #ff3d9f; }
  .tag { color: #7d879a; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
</style>
<Panel class="root">
  <div class="top">
    <div class="kicker">GARAGE JAM</div>
    <div id="flow-stage" class="stage">SETUP</div>
  </div>

  <Panel id="page-scan" class="page">
    <div id="scan-title" class="title">GETTING THE ROOM</div>
    <div id="scan-status" class="body">Look around slowly. Keep your table in view.</div>
    <div id="scan-progress" class="progress">0 / 3</div>
    <div id="scan-detail" class="detail">Waiting for floor, walls and table</div>
    <div id="flow-table-choices" class="page" style="display: none">
      <button id="flow-use-table" class="button">USE OUTLINED TABLE</button>
      <div class="row">
        <button id="flow-mark-table" class="button-cyan">MARK TABLE CORNERS</button>
        <button id="flow-skip-table" class="button-ghost">CONTINUE WITHOUT TABLE</button>
      </div>
    </div>
    <div class="row">
      <button id="flow-run-scan" class="button-ghost">RUN SPACE SETUP</button>
      <button id="flow-manual" class="button-pink">SET UP BY TOUCHING</button>
    </div>
  </Panel>

  <Panel id="page-mode" class="page" style="display: none">
    <div class="title">HOW DO YOU WANT TO WORK?</div>
    <div class="row">
      <button id="flow-mode-passthrough" class="big">SEE MY REAL SETUP</button>
      <button id="flow-mode-streaming" class="big big-alt">STREAM MY LAPTOP</button>
    </div>
    <div class="tag">SWITCH ANY TIME FROM THE WRIST MENU</div>
  </Panel>

  <Panel id="page-devices" class="page" style="display: none">
    <div class="title">MARK YOUR SETUP</div>
    <div class="body">Mark your real laptop and keyboard so passthrough cuts them into the garage. You can re-mark any time.</div>
    <div class="row">
      <button id="flow-mark-devices" class="button">MARK DEVICES</button>
      <button id="flow-skip-devices" class="button-ghost">SKIP FOR NOW</button>
    </div>
  </Panel>

  <Panel id="page-pairing" class="page" style="display: none">
    <div class="title">PAIR YOUR LAPTOP</div>
    <div class="body">Open <span id="flow-pair-url" class="title-accent">this device /sender</span> in Chrome on the laptop. Start Monitor 1-3 there; each channel pairs when it connects.</div>
    <div id="flow-monitor-status" class="body">Pairing: checking streams...</div>
    <div class="row">
      <button id="flow-refresh-streams" class="button-ghost">CHECK STREAMS</button>
      <button id="flow-forget-streams" class="button-ghost">FORGET</button>
    </div>
    <button id="flow-continue-2" class="button">CONTINUE TO GARAGE</button>
  </Panel>

  <Panel id="page-ready" class="page" style="display: none">
    <div class="title">GARAGE <span class="title-accent">READY</span></div>
    <div class="body">Look at your left wrist, or pinch thumb and index with your palm up.</div>
    <button id="flow-start" class="button">START</button>
  </Panel>
</Panel>
