<style>
  .card { width: 390px; flex-direction: column; gap: 12px; padding: 20px; border-radius: 18px; background-color: #272431; border-width: 1px; border-color: #5a4857; }
  .header { flex-direction: row; align-items: center; justify-content: space-between; }
  .title { color: #f8e7d6; font-size: 27px; font-weight: 800; }
  .page { flex-direction: column; gap: 10px; }
  .row { flex-direction: row; align-items: center; gap: 8px; }
  .screen { flex-direction: row; align-items: center; justify-content: space-between; background-color: #342d3a; padding: 8px; border-radius: 9px; }
  .screenText { flex-direction: column; gap: 2px; }
  .label { color: #f3e5df; font-size: 16px; font-weight: 800; }
  .note { color: #d4c1c7; font-size: 15px; }
  .button { flex-grow: 1; height: 40px; border-radius: 8px; background-color: #39313e; color: #f3e5df; font-size: 15px; font-weight: 700; }
  .toggle { width: 74px; height: 38px; border-radius: 8px; background-color: #4c424d; color: #f3e5df; font-size: 15px; font-weight: 800; }
  .action { height: 42px; border-radius: 8px; background-color: #e3b394; color: #2c232e; font-size: 16px; font-weight: 800; }
  .close { width: 42px; height: 36px; border-radius: 8px; background-color: #39313e; color: #f3e5df; font-size: 16px; font-weight: 700; }
  .address { color: #f2c3a6; font-size: 16px; font-weight: 700; }
  .codeRow { flex-direction: row; align-items: center; justify-content: space-between; background-color: #382e3d; padding: 10px; border-radius: 9px; }
  .code { color: #f8e7d6; font-size: 22px; font-weight: 800; }
</style>
<Panel id="mm-card" class="card">
  <div class="header">
    <div id="mm-title" class="title">Manage monitors</div>
    <button id="mm-close" class="close">X</button>
  </div>
  <div id="mm-layout" class="page">
    <div class="screen">
      <div class="screenText"><div class="label">Monitor 1</div><div id="mm-state-1" class="note">Ready to share</div></div>
      <button id="mm-monitor-1" class="toggle">On</button>
    </div>
    <div class="screen">
      <div class="screenText"><div class="label">Monitor 2</div><div id="mm-state-2" class="note">Disabled</div></div>
      <button id="mm-monitor-2" class="toggle">Off</button>
    </div>
    <div class="row">
      <button id="mm-layout-desk" class="button">Desk row</button>
      <button id="mm-layout-arc" class="button">Centered arc</button>
    </div>
    <div id="mm-placement-note" class="note">Grab a monitor to turn it. Open this page to move it.</div>
    <button id="mm-use-streaming" class="action" style="display:none">Show streamed monitors</button>
    <button id="mm-sharing" class="button">Screen sharing setup</button>
  </div>
  <div id="mm-connect" class="page" style="display:none">
    <div class="note">Open this address in Chrome on your laptop.</div>
    <div id="mm-address" class="address">/sender</div>
    <div class="codeRow"><div class="label">Room code</div><div id="mm-code" class="code">...</div></div>
    <div class="note">Enter the room code on the laptop. Then start sharing on an enabled monitor and pick a window or tab.</div>
    <button id="mm-back" class="action">Manage monitors</button>
  </div>
</Panel>
