<style>
  .card { width: 400px; flex-direction: column; gap: 8px; padding: 18px; border-radius: 18px; background-color: #272431; border-width: 1px; border-color: #5a4857; }
  .top { flex-direction: row; align-items: center; justify-content: space-between; }
  .title { color: #f8e7d6; font-size: 26px; font-weight: 800; }
  .status { color: #d5bac4; font-size: 15px; font-weight: 700; }
  .row { flex-direction: row; gap: 7px; }
  .button { flex-grow: 1; height: 38px; border-radius: 8px; background-color: #39313e; color: #f3e5df; font-size: 15px; font-weight: 700; }
  .active { background-color: #d575a5; color: #241727; }
  .small { font-size: 13px; }
  .note { color: #c5b5bd; font-size: 14px; }
  .close { width: 42px; height: 36px; border-radius: 8px; background-color: #39313e; color: #f3e5df; font-size: 14px; font-weight: 700; }
</style>
<Panel id="mm-card" class="card">
  <div class="top">
    <div class="title">Monitor layout</div>
    <button id="mm-close" class="close">X</button>
  </div>
  <div id="mm-status" class="status">Monitor 1 / ARC / flat</div>
  <div class="row">
    <button id="mm-monitor-1" class="button active">1</button>
    <button id="mm-monitor-2" class="button">2</button>
    <button id="mm-monitor-3" class="button">3</button>
  </div>
  <div class="row">
    <button id="mm-preset" class="button">PRESET: ARC</button>
    <button id="mm-lock" class="button">LOCK: OFF</button>
  </div>
  <div class="row">
    <button id="mm-curve-down" class="button small">CURVE -</button>
    <button id="mm-curve-up" class="button small">CURVE +</button>
  </div>
  <div class="row">
    <button id="mm-width-down" class="button small">WIDTH -</button>
    <button id="mm-width-up" class="button small">WIDTH +</button>
    <button id="mm-height-down" class="button small">HEIGHT -</button>
    <button id="mm-height-up" class="button small">HEIGHT +</button>
  </div>
  <div class="row">
    <button id="mm-recenter" class="button small">RECENTER</button>
    <button id="mm-save" class="button small">SAVE LAYOUT</button>
  </div>
  <div class="note">Grab an unlocked monitor to move it.</div>
</Panel>
